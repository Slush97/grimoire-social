{
  "name": "@grimoire/social-types",
  "version": "0.1.0",
  "description": "Shared Zod wire-format schemas and hero roster for Grimoire Social and the Grimoire desktop client.",
  "type": "module",
  "main": "./dist/schemas.js",
  "types": "./dist/schemas.d.ts",
  "exports": {
    ".": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./heroes": {
      "types": "./dist/heroes.d.ts",
      "default": "./dist/heroes.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "zod": "^3.23.0"
  }
}
